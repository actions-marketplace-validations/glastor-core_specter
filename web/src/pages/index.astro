---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Comparison from '../components/Comparison.astro';
import Playground from '../components/Playground.astro';
import RulesBento from '../components/RulesBento.astro';
import ArchitectureFlow from '../components/ArchitectureFlow.astro';
import CodeTabs from '../components/CodeTabs.astro';
import Faq from '../components/Faq.astro';
import Enterprise from '../components/Enterprise.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-cyber-dark text-slate-100 antialiased selection:bg-cyber-cyan selection:text-cyber-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080c14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Red Hat Typography Family (Google Fonts) with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@700;800;900&family=Red+Hat+Mono:wght@400;500;600;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Material Symbols Outlined -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..24,400,0,0&display=swap"
      rel="stylesheet"
    />

    <title>GLASTOR® — specter v0.2.1 | Zero-Compiler Polyglot AST API Contract Differ & SemVer Gate</title>
    <meta name="description" content="Zero-Compiler Polyglot AST API Contract Differ, Trojan Breaking-Change Detector & Mathematical SemVer Gatekeeper in Rust. Sub-5ms latency across Rust and TypeScript." />
    <meta name="keywords" content="Rust, TypeScript, API Contract, SemVer, AST diff, GitHub Actions, breaking change detector, zero compiler, SARIF, CycloneDX SBOM" />
    <meta name="author" content="GLASTOR® Core Systems" />
    <link rel="canonical" href="https://specter.glastor.es/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="GLASTOR® Core" />
    <meta property="og:url" content="https://specter.glastor.es/" />
    <meta property="og:title" content="GLASTOR® — specter v0.2.1 | Zero-Compiler Polyglot AST API Differ" />
    <meta property="og:description" content="Stop trusting human and AI commit messages blindly. Enforce mathematical SemVer and catch breaking changes in <5ms." />
    <meta property="og:image" content="https://res.cloudinary.com/dzualplqi/image/upload/v1794597633/specter_lqfmhu.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GLASTOR® Specter — Zero-Compiler Polyglot AST API Contract Differ" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@glastor_dev" />
    <meta name="twitter:title" content="GLASTOR® — specter v0.2.1 | Zero-Compiler Polyglot AST API Differ" />
    <meta name="twitter:description" content="Stop trusting human and AI commit messages blindly. Enforce mathematical SemVer and catch breaking changes in <5ms." />
    <meta name="twitter:image" content="https://res.cloudinary.com/dzualplqi/image/upload/v1794597633/specter_lqfmhu.png" />
    <meta name="twitter:image:alt" content="GLASTOR® Specter — Zero-Compiler Polyglot AST API Contract Differ" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "GLASTOR® Specter",
        "softwareVersion": "0.2.1",
        "operatingSystem": "Linux, macOS, Windows",
        "applicationCategory": "DeveloperApplication",
        "url": "https://specter.glastor.es/",
        "codeRepository": "https://github.com/glastor-core/specter",
        "releaseNotes": "https://github.com/glastor-core/specter/releases",
        "author": {
          "@type": "Organization",
          "name": "GLASTOR® Core Systems",
          "url": "https://glastor.es"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Zero-Compiler Polyglot AST API Contract Differ, Trojan Breaking-Change Guard & Mathematical SemVer Gatekeeper in Rust.",
        "programmingLanguage": ["Rust", "TypeScript"]
      }
    </script>
  </head>

  <body class="min-h-screen bg-cyber-dark text-slate-100 flex flex-col font-sans selection:bg-cyber-indigo selection:text-white">
    <Navbar />

    <main class="flex-grow">
      <Hero />
      <Comparison />
      <Playground />
      <RulesBento />
      <ArchitectureFlow />
      <CodeTabs />
      <Faq />
      <Enterprise />
    </main>

    <Footer />
  </body>
</html>
