---
// RulesBento.astro - Rule Catalog Bento Grid
---

<section id="rules" class="py-24 bg-cyber-dark/80 border-t border-cyber-border/70 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyber-amber/10 border border-cyber-amber/30 text-cyber-amber text-xs font-mono mb-4">
        <span class="material-symbols-outlined notranslate text-sm" translate="no" aria-hidden="true">rule</span>
        <span>RULE ENGINE CATALOG</span>
      </div>
      <h2 class="font-display font-black text-3xl sm:text-5xl text-white tracking-tight mb-4">
        Deterministic AST Contract Rules
      </h2>
      <p class="font-sans text-slate-300 text-base sm:text-lg">
        Every rule in Specter maps directly to SemVer specifications. No fuzzy heuristics—just pure, reproducible AST semantics.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card 1: SPC001 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-rose-500/10 border border-rose-500/30 text-rose-400">
            SPC001 • MAJOR
          </span>
          <span class="material-symbols-outlined notranslate text-cyber-indigo text-xl" translate="no" aria-hidden="true">function</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Function Signature Mutation
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          Public function parameter count, ordering, or types modified without backward-compatible default arguments.
        </p>
      </div>

      <!-- Card 2: SPC002 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-rose-500/10 border border-rose-500/30 text-rose-400">
            SPC002 • MAJOR
          </span>
          <span class="material-symbols-outlined notranslate text-rose-400 text-xl" translate="no" aria-hidden="true">visibility_off</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Symbol Visibility Reduction
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          Public symbol deleted or demoted from <code class="notranslate text-cyber-cyan font-mono" translate="no">pub</code> / <code class="notranslate text-cyber-cyan font-mono" translate="no">export</code> to private or internal scope.
        </p>
      </div>

      <!-- Card 3: SPC007 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-rose-500/10 border border-rose-500/30 text-rose-400">
            SPC007 • MAJOR
          </span>
          <span class="material-symbols-outlined notranslate text-cyber-cyan text-xl" translate="no" aria-hidden="true">tune</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Optional Property to Required
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          TypeScript interface property mutated from optional (<code class="notranslate text-cyber-cyan font-mono" translate="no">?</code>) to required, breaking existing object instances.
        </p>
      </div>

      <!-- Card 4: SPC004 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-rose-500/10 border border-rose-500/30 text-rose-400">
            SPC004 • MAJOR
          </span>
          <span class="material-symbols-outlined notranslate text-amber-400 text-xl" translate="no" aria-hidden="true">list_alt</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Enum Variant Mutation
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          Public enum variant removed or payload tuple/struct altered, breaking pattern matching in client code.
        </p>
      </div>

      <!-- Card 5: SPC006 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
            SPC006 • MINOR
          </span>
          <span class="material-symbols-outlined notranslate text-cyber-emerald text-xl" translate="no" aria-hidden="true">add_circle</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Additive Public Surface
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          New public function, struct, or interface added in a fully backward-compatible manner. Requires MINOR bump.
        </p>
      </div>

      <!-- Card 6: SPC009 -->
      <div class="p-6 rounded-2xl bg-cyber-card/90 border border-cyber-border hover:border-cyber-indigo/50 transition-all hover:scale-[1.01] shadow-lg group">
        <div class="flex items-center justify-between mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-cyber-cyan/10 border border-cyber-cyan/30 text-cyber-cyan">
            SPC009 • PATCH
          </span>
          <span class="material-symbols-outlined notranslate text-cyber-cyan text-xl" translate="no" aria-hidden="true">description</span>
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2 group-hover:text-cyber-cyan transition-colors">
          Internal Logic / Docs Fix
        </h3>
        <p class="font-sans text-xs text-slate-300 leading-relaxed">
          Function body implementation, doc comments, or private helpers updated without touching public exported signatures.
        </p>
      </div>
    </div>
  </div>
</section>
