---
// Hero.astro - GLASTOR® Specter
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Glowing Background Gradients -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-cyber-indigo/25 via-cyber-cyan/15 to-transparent blur-[140px] pointer-events-none rounded-full -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[350px] h-[250px] bg-cyber-purple/20 blur-[120px] pointer-events-none rounded-full -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyber-card/80 border border-cyber-border hover:border-cyber-indigo/50 text-slate-300 text-xs font-mono mb-8 backdrop-blur-sm shadow-md transition-all">
        <span class="w-2 h-2 rounded-full bg-cyber-cyan animate-pulse"></span>
        <span class="text-cyber-cyan font-bold tracking-wider uppercase text-[11px]">Zero-Compiler AST Differ</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-300 font-semibold">&lt; 5 ms Latency</span>
        <span class="text-slate-500">•</span>
        <span class="text-cyber-indigo font-semibold">GitHub Marketplace @v1</span>
      </div>

      <!-- Main Headline in Red Hat Display -->
      <h1 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight text-white mb-6 leading-[1.08]">
        Mathematical SemVer <br class="hidden sm:inline"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyber-cyan via-cyber-indigo to-cyber-purple">
          API Contract Gatekeeper
        </span>
      </h1>

      <!-- Subtitle in Red Hat Text -->
      <p class="font-sans text-base sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Stop trusting human and AI commit messages blindly. Specter detects <strong class="text-white">Trojan Breaking Changes</strong> across Rust and TypeScript public APIs in <strong>sub-5ms</strong> raw AST without invoking <code class="px-1.5 py-0.5 rounded bg-cyber-card border border-cyber-border text-cyber-cyan text-sm font-mono">rustc</code> or <code class="px-1.5 py-0.5 rounded bg-cyber-card border border-cyber-border text-cyber-cyan text-sm font-mono">tsc</code>.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href="https://github.com/marketplace/actions/glastor-specter-polyglot-ast-api-contract-semver-gatekeeper"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-cyber-indigo to-indigo-600 hover:from-cyber-indigoHover hover:to-indigo-500 text-white font-semibold text-sm shadow-xl shadow-cyber-indigo/25 flex items-center justify-center gap-2.5 transition-all hover:scale-[1.02] border border-indigo-400/30"
        >
          <span class="material-symbols-outlined text-lg">store</span>
          <span>Add to GitHub Workflow</span>
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>

        <a
          href="#comparison"
          class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-cyber-card/90 hover:bg-slate-800 border border-cyber-border hover:border-cyber-cyan/50 text-slate-200 font-semibold text-sm flex items-center justify-center gap-2 transition-all hover:scale-[1.02]"
        >
          <span class="material-symbols-outlined text-lg text-cyber-cyan">compare_arrows</span>
          <span>View Comparison Matrix</span>
        </a>
      </div>

      <!-- 5-Line Copy-Paste Snippet Card -->
      <div class="max-w-2xl mx-auto rounded-2xl bg-cyber-card/90 border border-cyber-border shadow-2xl p-5 text-left relative overflow-hidden backdrop-blur-xl">
        <div class="flex items-center justify-between pb-3 border-b border-cyber-border mb-3">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
            <span class="text-xs text-slate-400 font-mono ml-2">.github/workflows/ci.yml</span>
          </div>
          <button
            id="copy-snippet-btn"
            class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-cyber-border/70 hover:bg-cyber-border text-xs text-cyber-cyan font-mono transition-colors"
            title="Copy snippet"
          >
            <span class="material-symbols-outlined text-sm" id="copy-icon">content_copy</span>
            <span id="copy-text">Copy</span>
          </button>
        </div>

        <pre class="font-mono text-xs sm:text-sm text-slate-300 overflow-x-auto leading-relaxed py-1"><code id="snippet-code"><span class="text-slate-500"># Plug & Play in &lt; 5ms — No rustc / tsc setup required</span>
- <span class="text-cyber-cyan">name</span>: <span class="text-slate-200">Audit API Contract & SemVer Gate</span>
  <span class="text-cyber-cyan">uses</span>: <span class="text-cyber-emerald font-semibold">glastor-core/specter@v1</span>
  <span class="text-cyber-cyan">with</span>:
    <span class="text-cyber-indigo">base-ref</span>: <span class="text-amber-300">&dollar;&#123;&#123; github.base_ref || 'origin/main' &#125;&#125;</span></code></pre>

        <div class="mt-3 pt-3 border-t border-cyber-border/50 flex flex-wrap items-center justify-between text-[11px] text-slate-400 font-mono gap-2">
          <span class="flex items-center gap-1.5 text-cyber-emerald">
            <span class="material-symbols-outlined text-sm">verified</span>
            <span>Zero build artifacts needed</span>
          </span>
          <span class="flex items-center gap-1.5 text-slate-400">
            <span class="material-symbols-outlined text-sm">bolt</span>
            <span>Takes ~3 seconds total step runtime</span>
          </span>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-12 max-w-4xl mx-auto">
        <div class="p-4 rounded-xl bg-cyber-card/60 border border-cyber-border/80 text-left">
          <div class="flex items-center gap-2 text-cyber-cyan mb-1">
            <span class="material-symbols-outlined text-lg">speed</span>
            <span class="font-mono font-bold text-lg sm:text-xl text-white">&lt; 5 ms</span>
          </div>
          <span class="text-xs text-slate-400">Pure AST diffing latency</span>
        </div>

        <div class="p-4 rounded-xl bg-cyber-card/60 border border-cyber-border/80 text-left">
          <div class="flex items-center gap-2 text-cyber-emerald mb-1">
            <span class="material-symbols-outlined text-lg">cancel</span>
            <span class="font-mono font-bold text-lg sm:text-xl text-white">0 Compilers</span>
          </div>
          <span class="text-xs text-slate-400">No rustc, tsc, or rustdoc</span>
        </div>

        <div class="p-4 rounded-xl bg-cyber-card/60 border border-cyber-border/80 text-left">
          <div class="flex items-center gap-2 text-cyber-indigo mb-1">
            <span class="material-symbols-outlined text-lg">layers</span>
            <span class="font-mono font-bold text-lg sm:text-xl text-white">Polyglot</span>
          </div>
          <span class="text-xs text-slate-400">Rust & TypeScript / Deno</span>
        </div>

        <div class="p-4 rounded-xl bg-cyber-card/60 border border-cyber-border/80 text-left">
          <div class="flex items-center gap-2 text-cyber-purple mb-1">
            <span class="material-symbols-outlined text-lg">security</span>
            <span class="font-mono font-bold text-lg sm:text-xl text-white">SARIF & SBOM</span>
          </div>
          <span class="text-xs text-slate-400">GitHub Code Scanning ready</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-snippet-btn');
  const copyIcon = document.getElementById('copy-icon');
  const copyText = document.getElementById('copy-text');

  const snippet = `- name: Audit API Contract & SemVer Gate\n  uses: glastor-core/specter@v1\n  with:\n    base-ref: \${{ github.base_ref || 'origin/main' }}`;

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(snippet);
        if (copyIcon && copyText) {
          copyIcon.textContent = 'check';
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyIcon.textContent = 'content_copy';
            copyText.textContent = 'Copy';
          }, 2000);
        }
      } catch (e) {
        console.error(e);
      }
    });
  }
</script>
